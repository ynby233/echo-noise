# Echo-Noise runtime environment template
#
# To use this with GUI-managed Docker containers, copy this file to runtime.env
# in the same /app/config volume and uncomment/edit only the variables you need.
# Lines are parsed by /bin/sh, so keep values as KEY=value or KEY="value".

# TZ=Asia/Shanghai
# ACCESS_LOG=false
# SESSION_SECRET=replace-with-at-least-32-random-characters

# Browser Web Push (PWA). Generate one stable key pair with:
#   go run ./cmd/vapid-keygen
# Or keep the private key out of terminal output:
#   go run ./cmd/vapid-keygen -private-key-file /path/to/new-private-key
# Keep the private key outside source control. A mounted file takes precedence
# over WEB_PUSH_VAPID_PRIVATE_KEY and is recommended for production.
# WEB_PUSH_VAPID_PUBLIC_KEY=
# GUI panels such as fnOS may use this directly. Leave PRIVATE_KEY_FILE unset.
# WEB_PUSH_VAPID_PRIVATE_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY_FILE=/run/secrets/echo-noise-vapid-private-key
# Use either a mailto URI or the public HTTPS site URL.
# WEB_PUSH_VAPID_SUBJECT=https://example.com/

# Comma-separated proxy IPs/CIDRs that are allowed to supply X-Forwarded-For.
# Leave unset when the container is reached directly.
# TRUSTED_PROXIES=172.18.0.1/32

# SQLite defaults for persistent Docker deployments.
# DB_TYPE=sqlite
# DB_PATH=/app/data/noise.db

# MCP HTTP/SSE endpoint. Set NOTE_HTTP_PORT=0 to disable the HTTP listener.
# NOTE_HOST=http://localhost:1314
# NOTE_HTTP_PORT=1315
