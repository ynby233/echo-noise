LOG_LEVEL=info

DB_TYPE=sqlite
DB_PATH=./data/noise.db

DB_HOST=your.db.host
DB_PORT=5432
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=noise
DB_SSL_MODE=disable
DB_TIMEZONE=Asia/Shanghai

DB_CHARSET=utf8mb4

CORS_ORIGINS=
TZ=Asia/Shanghai

# PWA Web Push: keep the private key stable across restarts and rotations.
WEB_PUSH_VAPID_PUBLIC_KEY=
# GUI-managed containers (for example fnOS/Portainer) may store the private
# key directly. Leave PRIVATE_KEY_FILE empty when using this option.
WEB_PUSH_VAPID_PRIVATE_KEY=
# File-mounted secrets are preferred when the deployment UI supports them.
WEB_PUSH_VAPID_PRIVATE_KEY_FILE=
WEB_PUSH_VAPID_SUBJECT=mailto:owner@example.com
