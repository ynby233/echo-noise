# Build from repository root; keep the scheduler version separate from app updates.
FROM docker:28.5.1-cli AS docker-cli
FROM ghcr.io/dagucloud/dagu:2.18.1@sha256:35fe69dd04cc20604c91c5eec1ee1c8c27ed15427714a5ec9c9ceb3d3ea8608a
USER root
RUN apt-get update && apt-get install -y --no-install-recommends python3 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
COPY scripts/update/executor.py /opt/echo-noise-update/executor.py
RUN chmod 700 /opt/echo-noise-update/executor.py
ENV PUID=0 PGID=0 DAGU_AUTH_MODE=builtin
